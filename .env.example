APP_NAME=Kaladhar Auto-Reel
ENVIRONMENT=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# Required for private per-user brand logos. Create this bucket as private.
# Keep the service-role key in backend/.env only; never add it to frontend env.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BRANDING_BUCKET=brand-logos
SUPABASE_TEMPLATE_BUCKET=templates
